import os
import yaml
import pandas as pd
from google.colab import drive

# 1. Mount your Google Drive (you will get a pop-up to allow access)
drive.mount('/content/drive')

# 2. Define the Constants
CYP3A4_SEQ = ""
HEME_SMILES = "CC1=C(C)C2=CC3=C(C=C)C(C)=C(N3[Fe]N2)C=C4C(C)=C(C=C)C(=N4)C=C5C(C)=C(CCC(O)=O)C(=N5)C=C1CCC(O)=O"

# 3. Load the dataset from your Drive
drive_path = "/content/drive/MyDrive/OpenADMET_Challenge/data/cyp-challenge-TEST.csv"
df = pd.read_csv(drive_path)

# 4. Create the YAML configurations
os.makedirs("boltz_inputs", exist_ok=True)
for idx, row in df.iterrows():
    mol_name = row['Molecule_Name']
    target_smiles = row['SMILES']

    boltz_config = {
        "version": 1,
        "sequences": [
            {"protein": {"id": "A", "sequence": CYP3A4_SEQ}},
            {"ligand": {"id": "HEM", "smiles": HEME_SMILES}},
            {"ligand": {"id": "LIG", "smiles": target_smiles}}
        ]
    }

    with open(f"boltz_inputs/{mol_name}.yaml", 'w') as f:
        yaml.dump(boltz_config, f, sort_keys=False)

print(f"Successfully generated {len(df)} YAML files in 'boltz_inputs'.")
