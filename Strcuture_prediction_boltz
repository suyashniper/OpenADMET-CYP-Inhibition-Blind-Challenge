import os
import shutil
import glob
from google.colab import files

print("Packaging results for submission...")
os.makedirs("/content/final_submission", exist_ok=True)

# Find all predicted CIF files from the bash run
predicted_files = glob.glob("/content/boltz_outputs/**/predictions/*/*.cif", recursive=True)

if not predicted_files:
    print("Error: No .cif files found. Wait for the previous cell to finish.")
else:
    for file_path in predicted_files:
        shutil.copy(file_path, "/content/final_submission/")

    shutil.make_archive("OpenADMET_Structure_Predictions", 'zip', "/content/final_submission")
    print(f"Successfully zipped {len(predicted_files)} files. Starting download...")
    files.download("OpenADMET_Structure_Predictions.zip")
